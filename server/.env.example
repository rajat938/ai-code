PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ollama_mern
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5:1.5b
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# ---- Speed settings ----
# Keep the model loaded in RAM between prompts ("-1" = forever)
OLLAMA_KEEP_ALIVE=24h
# Context window (tokens). Smaller = faster, less RAM
OLLAMA_NUM_CTX=4096
# Max length of one answer (tokens)
OLLAMA_NUM_PREDICT=512
# CPU threads, 0 = automatic. Set to your number of CPU cores if answers are slow
OLLAMA_NUM_THREAD=0
# How many earlier messages the model remembers in a chat
HISTORY_LIMIT=6
# Preload the model when the server starts
OLLAMA_WARMUP=true

# ---- Company policy documents (Admin → Knowledge) ----
# Small embedding model for meaning-based search ("time off" finds "leave"). Empty = keyword search only.
EMBED_MODEL=all-minilm
# Relevance thresholds (see the scores in Admin → Knowledge → Test a question)
KB_MIN_KEYWORD_SCORE=1.2
KB_MIN_SIMILARITY=0.6


# ---- Optional: GPU AI server on YOUR network (vLLM / SGLang / llama.cpp / LM Studio) ----
# Leave LOCAL_AI_SERVER_URL empty if you only use Ollama on this server.
# Must be a PRIVATE address (192.168.x.x, 10.x.x.x, 172.16-31.x.x, localhost or a Docker service name).
# Public internet addresses are refused, so nothing can leave your network.
LOCAL_AI_SERVER_NAME=GPU server
LOCAL_AI_SERVER_URL=
# e.g. LOCAL_AI_SERVER_URL=http://192.168.1.50:8000/v1
# Only if vLLM was started with --api-key
LOCAL_AI_SERVER_API_KEY=
# Empty = use every model the server offers
LOCAL_AI_SERVER_MODELS=
LOCAL_AI_SERVER_MAX_TOKENS=1024
LOCAL_AI_SERVER_TIMEOUT_SECONDS=120
